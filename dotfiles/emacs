; stop creating ~ files
(setq make-backup-files nil)

(add-to-list 'custom-theme-load-path "~/.emacs.d/themes/")
(load-theme 'vscode-dark-plus t)

(menu-bar-mode -1)
(line-number-mode t)
(column-number-mode t)
(global-font-lock-mode t)

(package-initialize)
(add-to-list 'package-archives
	     '("melpa" . "https://melpa.org/packages/"))
(global-set-key (kbd "M-x") 'smex)
(global-set-key (kbd "M-X") 'smex-major-mode-commands)
;; This is the old M-x
(global-set-key (kbd "C-c C-c M-x") 'execute-extended-command)

; Boilerplates for python files
(auto-insert-mode 1)
(setq auto-insert-query nil) ;; don't ask me
(eval-after-load 'autoinsert
  '(define-auto-insert
     '("\\.\\py\\'" . "python skeleton")
     '(""
       "#!/usr/bin/env python3" \n
       "")))

; Python IDE features via the built-in LSP client (eglot) + pylsp
; The server (python3-pylsp) is installed by setup.yml
(add-hook 'python-mode-hook 'eglot-ensure)
(add-hook 'python-ts-mode-hook 'eglot-ensure)
; Show inline completion suggestions while typing (TAB to accept)
(global-completion-preview-mode 1)


(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(package-selected-packages '(smex yaml-mode multiple-cursors)))
