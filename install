#!/usr/bin/env bash
#
# install all dot files to ~ via symlinks

## symlink dotfiles
for f in $PWD/dotfiles/*; do
    ln -nsfv "$f" "$HOME/.${f##*/}"
done

## deploy non dotfiles
mkdir -p "$HOME/.emacs.d/themes"
ln -nsfv "$PWD/vscode-dark-plus-theme.el" "$HOME/.emacs.d/themes/vscode-dark-plus-theme.el"

mkdir -p "$HOME/.local/share/konsole"
ln -nsfv "$PWD/konsole.profile" "$HOME/.local/share/konsole/konsole.profile"

# download and install our font
font_zip="DejaVuSansMono.zip"
font_url="https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/$font_zip"
font_path="DejaVuSansMNerdFontMono-Regular.ttf"
font_dest="$HOME/.fonts"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT # cleanup after ourselves
curl -fsSL -o "$tmp/$font_zip" "$font_url"
mkdir -p "$font_dest"
unzip -o -j "$tmp/$font_zip" "$font_path" -d "$font_dest"

## install packages

if [ -f /etc/lsb-release ]; then
    sudo apt-get update
    sudo apt-get install -y ansible

    sudo ansible-playbook "$PWD/setup.yml" --ask-become-pass
else
    echo "Unsupported Linux distro"
    exit
fi

