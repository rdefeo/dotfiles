#!/usr/bin/env bash
#
# install all dot files to ~ via symlinks

## symlink dotfiles
for f in $PWD/dotfiles/*; do
    ln -nsfv "$f" "$HOME/.${f##*/}"
done

## deploy non dotfiles
mkdir -p "$HOME/.emacs.d/themes"
ln -nsfv "$PWD/vscode-dark-plus-theme.el" "$HOME/.emacs.d/themes/vscode-dark-plus-theme.el"

# maybe download this instead?
# wget -nv https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/DejaVuSansMono.zip
# then unzip just the file we need?
#
#mkdir -p "$HOME/.fonts"
#echo "SYMLINK: ln -nsfv $PWD/DejaVuSansMNerdFontMono-Regular.ttf $HOME/.fonts/DejaVuSansMNerdFontMono-Regular.ttf"

## install packages

if [ -f /etc/lsb-release ]; then
    sudo apt-get update
    sudo apt-get install -y ansible

    sudo ansible-playbook "$PWD/setup.yml" --ask-become-pass
else
    echo "Unsupported Linux distro"
    exit
fi

